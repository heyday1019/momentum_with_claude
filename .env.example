# Supabase (https://supabase.com/dashboard 의 프로젝트 settings에서 복사)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Supabase service role key — RLS 우회 가능. 절대 클라이언트 번들에 노출 금지.
# /admin 페이지 등 서버 전용 코드에서 cross-user 데이터 조회에 사용.
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# OpenRouter (https://openrouter.ai/keys 에서 발급)
OPENROUTER_API_KEY=<sk-or-v1-...>

# 사이트 URL (OAuth redirect용; 로컬은 http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 관리자 이메일 — 콤마 구분. 이 목록에 포함된 사용자만 /admin 접근 가능.
ADMIN_EMAILS=heyday1019@gmail.com
